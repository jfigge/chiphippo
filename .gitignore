# ── Build outputs ─────────────────────────────────────────────────────────────
build/
dist/
data/
keys/
certs/

# ── Doc-screenshot capture harness (local dev tooling; only the PNGs it
#    writes into src/web/docs/images/ are committed) ───────────────────────────
.docs-build/

# ── Mac App Store provisioning profiles ───────────────────────────────────────
# Per-developer, and they embed a team-specific certificate. Dropped into
# src/packaging/ for `make mas` / `make mas-dev` (see STORE-PUBLISHING.md).
# Never commit them.
*.provisionprofile

# ── Node / npm ────────────────────────────────────────────────────────────────
src/node_modules/
src/npm-debug.log*
.npm

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editor / IDE ──────────────────────────────────────────────────────────────
*.swp
.vscode/

# ── Electron builder cache ────────────────────────────────────────────────────
.electron-builder-cache/

# ── Local env files ───────────────────────────────────────────────────────────
# Tracked templates live in *.env.example; the real files stay local.
*.env
!*.env.example
