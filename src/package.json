{
  "name": "chiphippo",
  "version": "1.1.1",
  "description": "Design and simulate 74xx TTL logic circuits on virtual breadboards",
  "homepage": "https://github.com/jfigge/chiphippo",
  "repository": {
    "type": "git",
    "url": "https://github.com/jfigge/chiphippo.git"
  },
  "author": {
    "name": "Jason Figge",
    "email": "jason.figge@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "main": "app/main.js",
  "scripts": {
    "start": "electron app/main.js",
    "dev": "electron app/main.js --dev",
    "fmt": "prettier --write \"web/**/*.{js,css,html}\" \"app/**/*.js\"",
    "lint": "eslint \"web/scripts/**/*.js\" \"app/**/*.js\"",
    "test": "node --test --test-timeout=30000 \"app/tests/**/*.test.js\" \"web/scripts/tests/**/*.test.js\"",
    "vendor-markdown": "esbuild web/scripts/vendor/markdown-entry.js --bundle --format=esm --outfile=web/scripts/vendor/markdown.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "dompurify": "^3.4.7",
    "electron": "^42.1.0",
    "electron-builder": "~26.17.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "globals": "^16.1.0",
    "jsdom": "^27.0.1",
    "marked": "^18.0.4",
    "pdfjs-dist": "^6.1.200",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "build": {
    "appId": "com.chiphippo.app",
    "productName": "Chip Hippo",
    "copyright": "Copyright © 2026 Jason Figge",
    "icon": "web/chiphippo-icon.ico",
    "artifactName": "Chip-Hippo-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "jfigge",
      "repo": "chiphippo"
    },
    "nsis": {
      "artifactName": "Chip-Hippo-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "web/**/*",
      "!app/tests/**",
      "!web/scripts/tests/**",
      "package.json"
    ],
    "npmRebuild": false,
    "toolsets": {
      "appimage": "1.0.2"
    },
    "mac": {
      "icon": "web/chiphippo-mac-icon.png",
      "files": [
        "!node_modules/@serialport/bindings-cpp/prebuilds/{android,linux,win32}-*/**"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "mas": {
      "type": "distribution",
      "icon": "web/chiphippo-mac-icon.png",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "notarize": false,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "packaging/entitlements.mas.plist",
      "entitlementsInherit": "packaging/entitlements.mas.inherit.plist",
      "provisioningProfile": "packaging/embedded.provisionprofile",
      "target": [
        {
          "target": "pkg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "masDev": {
      "type": "development",
      "notarize": false,
      "entitlements": "packaging/entitlements.mas.plist",
      "entitlementsInherit": "packaging/entitlements.mas.inherit.plist",
      "provisioningProfile": "packaging/development.provisionprofile"
    },
    "win": {
      "icon": "web/chiphippo-icon.ico",
      "files": [
        "!node_modules/@serialport/bindings-cpp/prebuilds/{android,darwin,linux}-*/**"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "web/icons",
      "files": [
        "!node_modules/@serialport/bindings-cpp/prebuilds/{android,darwin,win32}-*/**"
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1"
      ]
    }
  }
}
