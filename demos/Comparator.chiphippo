          },
          {
            "id": "an14",
            "kind": "label",
            "x": -32,
            "y": -24.2,
            "text": "the left four, B on the right four. Exactly",
            "color": "#808080"
          },
          {
            "id": "an15",
            "kind": "label",
            "x": -32,
            "y": -22.4,
            "text": "one of the three lamps is lit — greater,",
            "color": "#808080"
          },
