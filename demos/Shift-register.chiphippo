            "y": -34.8,
            "text": "74LS165 — Parallel-in, serial-out"
          },
          {
            "id": "an13",
            "kind": "label",
            "x": -37,
            "y": -33,
            "text": "The '164 backwards: the switch bank is",
            "color": "#808080"
          },
          {
            "id": "an14",
            "kind": "label",
            "x": -37,
            "y": -31.2,
            "text": "loaded in PARALLEL while LOAD̄ is low, then",
            "color": "#808080"
          },
          {
            "id": "an15",
            "kind": "label",
            "x": -37,
            "y": -29.4,
            "text": "LOAD̄ goes high and each clock edge walks",
            "color": "#808080"
          },
          {
            "id": "an16",
            "kind": "label",
            "x": -37,
            "y": -27.6,
            "text": "the byte out of QH one bit at a time —",
            "color": "#808080"
          },
          {
            "id": "an17",
            "kind": "label",
            "x": -37,
            "y": -25.8,
            "text": "H first, A last.",
            "color": "#808080"
          }
