          {
            "id": "an12",
            "kind": "label",
            "x": -32,
            "y": -29.6,
            "text": "74LS138 — 3-to-8 line decoder"
          },
          {
            "id": "an13",
            "kind": "label",
            "x": -32,
            "y": -27.799999999999997,
            "text": "Switches A, B, C select one of eight",
            "color": "#808080"
          },
          {
            "id": "an14",
            "kind": "label",
            "x": -32,
            "y": -26,
            "text": "outputs; G1 is tied HIGH and both G2s",
            "color": "#808080"
          },
          {
            "id": "an15",
            "kind": "label",
            "x": -32,
            "y": -24.2,
            "text": "LOW, so the part is always enabled.",
            "color": "#808080"
          },
          {
            "id": "an16",
            "kind": "label",
            "x": -32,
            "y": -22.4,
            "text": "The outputs are active LOW, so each LED",
            "color": "#808080"
          },
          {
            "id": "an17",
            "kind": "label",
            "x": -32,
            "y": -20.6,
            "text": "is wired the other way up: exactly one",
            "color": "#808080"
          },
          {
            "id": "an18",
            "kind": "label",
            "x": -32,
            "y": -18.8,
            "text": "lights, and it is the one selected.",
            "color": "#808080"
          }
        ],
