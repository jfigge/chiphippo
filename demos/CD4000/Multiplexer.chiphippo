          {
            "id": "an7",
            "kind": "label",
            "x": -32,
            "y": -28.81,
            "text": "CD4066B — Quad bilateral switch (CMOS)"
          },
          {
            "id": "an8",
            "kind": "label",
            "x": -32,
            "y": -27.01,
            "text": "It drives nothing: a switch whose CTL is",
            "color": "#808080"
          },
          {
            "id": "an9",
            "kind": "label",
            "x": -32,
            "y": -25.21,
            "text": "HIGH joins its two pins, and a level passes",
            "color": "#808080"
          },
          {
            "id": "an10",
            "kind": "label",
            "x": -32,
            "y": -23.41,
            "text": "EITHER way. IN A feeds switch A at IN/OUT;",
            "color": "#808080"
          },
          {
            "id": "an11",
            "kind": "label",
            "x": -32,
            "y": -21.61,
            "text": "IN B feeds switch B at OUT/IN — the same",
            "color": "#808080"
          },
          {
            "id": "an12",
            "kind": "label",
            "x": -32,
            "y": -19.81,
            "text": "part, backwards. Switches C and D are open.",
            "color": "#808080"
          }
        ],
