            "id": "an12",
            "kind": "label",
            "x": -32,
            "y": -21.61,
            "text": "L = S3·S4   M = S4·S1",
            "color": "#808080"
          },
          {
            "id": "an13",
            "kind": "label",
            "x": -32,
            "y": -19.81,
            "text": "An output is LOW only with BOTH inputs HIGH.",
            "color": "#808080"
          }
