            "x": -32,
            "y": -27.01,
            "text": "CD4516B — Binary up/down counter (CMOS)"
          },
          {
            "id": "an10",
            "kind": "label",
            "x": -32,
            "y": -25.21,
            "text": "The 4510's binary twin: counts 0–15 up or",
            "color": "#808080"
          },
          {
            "id": "an11",
            "kind": "label",
            "x": -32,
            "y": -23.41,
            "text": "down (UP/DN). CARRY lights at 15 going up",
            "color": "#808080"
          },
          {
            "id": "an12",
            "kind": "label",
            "x": -32,
            "y": -21.61,
            "text": "and at 0 going down. PRESET loads the P",
            "color": "#808080"
          },
          {
            "id": "an13",
            "kind": "label",
            "x": -32,
            "y": -19.81,
            "text": "pins (tied to 12); RESET clears.",
            "color": "#808080"
          }
        ],
