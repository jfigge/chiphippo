            "id": "an17",
            "kind": "label",
            "x": -32,
            "y": -21.61,
            "text": "INHIBIT HIGH holds the count; RESET HIGH",
            "color": "#808080"
          },
          {
            "id": "an18",
            "kind": "label",
            "x": -32,
            "y": -19.81,
            "text": "returns it to 0. CARRY is HIGH for 0–4.",
