        "annotations": [
          {
            "id": "an1",
            "kind": "label",
            "x": 0,
            "y": -14.6,
            "text": "PC817: a 5 V logic signal switching a 12 V circuit"
          },
          {
            "id": "an2",
            "kind": "label",
            "x": 0,
            "y": -12.8,
            "text": "The bottom rail is a 5 V supply, the top one a separate 12 V supply: the two",
            "color": "#808080"
          },
          {
            "id": "an3",
            "kind": "label",
            "x": 0,
            "y": -11,
            "text": "sides of the optocoupler share no connection. The slide switch lights its",
            "color": "#808080"
          },
          {
            "id": "an4",
            "kind": "label",
            "x": 0,
            "y": -9.2,
            "text": "infrared LED through 470 Ω (about 8 mA); the phototransistor then sinks the",
            "color": "#808080"
          },
          {
            "id": "an5",
            "kind": "label",
            "x": 0,
            "y": -7.4,
            "text": "12 V LED's current — but never more than the LED's current times its CTR, so at",
            "color": "#808080"
          },
          {
            "id": "an6",
            "kind": "label",
            "x": 0,
            "y": -5.6,
            "text": "100 % the 12 V LED gets about 8 mA where its 1 kΩ would let 10 mA through.",
            "color": "#808080"
          },
          {
            "id": "an7",
            "kind": "label",
            "x": 0,
            "y": -3.8,
            "text": "Set the CTR in the optocoupler's Properties (Spice Lite) and watch it change.",
            "color": "#808080"
          }
        ],
