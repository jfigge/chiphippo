        "annotations": [
          {
            "id": "an1",
            "kind": "label",
            "x": 0,
            "y": -12.8,
            "text": "LM358 as a comparator"
          },
          {
            "id": "an2",
            "kind": "label",
            "x": 0,
            "y": -11,
            "text": "The pot sets 1IN+; two 10 kΩ hold 1IN− at half the supply. With no feedback the",
            "color": "#808080"
          },
          {
            "id": "an3",
            "kind": "label",
            "x": 0,
            "y": -9.2,
            "text": "op-amp's gain throws 1OUT to its top or its bottom: the LED lights while the pot",
            "color": "#808080"
          },
          {
            "id": "an4",
            "kind": "label",
            "x": 0,
            "y": -7.4,
            "text": "is above 2.5 V. Turn it (Properties ▸ Position) and watch it switch.",
            "color": "#808080"
          },
          {
            "id": "an5",
            "kind": "label",
            "x": 0,
            "y": -5.6,
            "text": "Under Spice Lite the probe reads the voltages; its HIGH stops 1.5 V short of the",
            "color": "#808080"
          },
          {
            "id": "an6",
            "kind": "label",
            "x": 0,
            "y": -3.8,
            "text": "supply, as the LM358's does. The second unit is spare: a follower held at 0 V.",
            "color": "#808080"
          }
        ],
