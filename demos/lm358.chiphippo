          {
            "id": "an1",
            "kind": "label",
            "x": 0,
            "y": -12.8,
            "text": "LM358 as a non-inverting amplifier, gain 2"
          },
          {
            "id": "an2",
            "kind": "label",
            "x": 0,
            "y": -11,
            "text": "10 kΩ from 1OUT back to 1IN− and 10 kΩ from 1IN− to ground make 1OUT twice the",
            "color": "#808080"
          },
          {
            "id": "an3",
            "kind": "label",
            "x": 0,
            "y": -9.2,
            "text": "pot's voltage on 1IN+ — up to 7.5 V, 1.5 V short of the 9 V supply.",
            "color": "#808080"
          },
          {
            "id": "an4",
            "kind": "label",
            "x": 0,
            "y": -7.4,
            "text": "Run it with Spice Lite on and probe 1IN+ and 1OUT; turn the pot and the LED",
            "color": "#808080"
          },
          {
            "id": "an5",
            "kind": "label",
            "x": 0,
            "y": -5.6,
            "text": "follows, brighter as the output climbs. The logic engine has no voltages: there",
            "color": "#808080"
          },
          {
            "id": "an6",
            "kind": "label",
            "x": 0,
            "y": -3.8,
            "text": "the loop reads undefined.",
            "color": "#808080"
          }
        ],
