        "annotations": [
          {
            "id": "an1",
            "kind": "label",
            "x": 0,
            "y": -12.8,
            "text": "LM7805: 9 V in, 5 V out"
          },
          {
            "id": "an2",
            "kind": "label",
            "x": 0,
            "y": -11,
            "text": "The top rail is the 9 V supply; the LM7805 (IN · GND · OUT from the left) makes",
            "color": "#808080"
          },
          {
            "id": "an3",
            "kind": "label",
            "x": 0,
            "y": -9.2,
            "text": "the bottom rail 5 V, and the 74LS04 runs from it — slide the switch and the LED",
            "color": "#808080"
          },
          {
            "id": "an4",
            "kind": "label",
            "x": 0,
            "y": -7.4,
            "text": "follows. A 78xx needs its input 2 V above its output: set the supply to 5 V and",
            "color": "#808080"
          },
          {
            "id": "an5",
            "kind": "label",
            "x": 0,
            "y": -5.6,
            "text": "it drops out, and the chip goes dark with it.",
            "color": "#808080"
          },
          {
            "id": "an6",
            "kind": "label",
            "x": 0,
            "y": -3.8,
            "text": "On a real board give it 0.33 µF on IN and 0.1 µF on OUT.",
            "color": "#808080"
          }
        ],
