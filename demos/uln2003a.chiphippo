        "buses": [],
        "netNames": [],
        "annotations": [
          {
            "id": "an1",
            "kind": "label",
            "x": 0,
            "y": -14.6,
            "text": "ULN2003A driving a relay and an LED"
          },
          {
            "id": "an2",
            "kind": "label",
            "x": 0,
            "y": -12.8,
            "text": "Slide switch 1 feeds input 1: HIGH sinks output 1 to E, which pulls the relay in —",
            "color": "#808080"
          },
          {
            "id": "an3",
            "kind": "label",
            "x": 0,
            "y": -11,
            "text": "COM swings from NC (red) over to NO (green). COM (pin 9) is tied to +, so each",
            "color": "#808080"
          },
          {
            "id": "an4",
            "kind": "label",
            "x": 0,
            "y": -9.2,
            "text": "output's clamp diode catches the coil's kick when it lets go: no diode of your own.",
            "color": "#808080"
          },
          {
            "id": "an5",
            "kind": "label",
            "x": 0,
            "y": -7.4,
            "text": "Slide switch 2 sinks an LED's current through output 2 the same way.",
            "color": "#808080"
          },
          {
            "id": "an6",
            "kind": "label",
            "x": 0,
            "y": -5.6,
            "text": "Under Spice Lite each channel is its Darlington: about 1 V from output to E when",
            "color": "#808080"
          },
          {
            "id": "an7",
            "kind": "label",
            "x": 0,
            "y": -3.8,
            "text": "on, and the relay pulls in a few milliseconds after the coil is switched on.",
            "color": "#808080"
          }
        ],
