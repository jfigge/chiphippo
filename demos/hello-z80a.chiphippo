        "annotations": [
          {
            "id": "an1",
            "kind": "label",
            "x": -38,
            "y": -44.24,
            "text": "Z80A — Hello World"
          },
          {
            "id": "an2",
            "kind": "label",
            "x": -38,
            "y": -42.44,
            "text": "A Z80A runs the program in the AT28C256 ROM ($0000–$7FFF); the W65C22 VIA sits in the Z80's I/O space.",
            "color": "#808080"
          },
          {
            "id": "an3",
            "kind": "label",
            "x": -38,
            "y": -40.64,
            "text": "/IORQ selects the VIA and OUT (n),A writes register n. Press Run: the greeting is typed a letter every half second.",
            "color": "#808080"
          },
          {
            "id": "an4",
            "kind": "label",
            "x": -38,
            "y": -38.84,
            "text": "Hold the reset button to stop the CPU; let go and it starts again from $0000.",
            "color": "#808080"
          }
        ],
