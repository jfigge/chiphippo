          },
          {
            "id": "an2",
            "kind": "label",
            "x": 0,
            "y": -9.2,
            "text": "The same driver without the diode. Under Spice Lite, switch it off: the coil's",
            "color": "#808080"
          },
          {
            "id": "an3",
            "kind": "label",
            "x": 0,
            "y": -7.4,
            "text": "current has nowhere to go but through the transistor, which it drives into",
            "color": "#808080"
          },
          {
            "id": "an4",
            "kind": "label",
            "x": 0,
            "y": -5.6,
            "text": "breakdown — an inductive-kick warning says how hard. The previous desktop's",
            "color": "#808080"
          },
          {
            "id": "an5",
            "kind": "label",
            "x": 0,
            "y": -3.8,
            "text": "diode across the coil is the cure.",
            "color": "#808080"
          }
        ],
