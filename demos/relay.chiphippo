        "buses": [],
        "netNames": [],
        "annotations": [
          {
            "id": "an1",
            "kind": "label",
            "x": 0,
            "y": -14.6,
            "text": "A relay driven by a transistor"
          },
          {
            "id": "an2",
            "kind": "label",
            "x": 0,
            "y": -12.8,
            "text": "The relay's coil wants about 70 mA — more than a logic output gives — so an NPN",
            "color": "#808080"
          },
          {
            "id": "an3",
            "kind": "label",
            "x": 0,
            "y": -11,
            "text": "switches it: slide the switch and its base current turns it on, the coil pulls",
            "color": "#808080"
          },
          {
            "id": "an4",
            "kind": "label",
            "x": 0,
            "y": -9.2,
            "text": "COM from NC (red) over to NO (green). The 1N4148 across the coil carries the",
            "color": "#808080"
          },
          {
            "id": "an5",
            "kind": "label",
            "x": 0,
            "y": -7.4,
            "text": "coil's current when the transistor lets go, so nothing is kicked.",
            "color": "#808080"
          },
          {
            "id": "an6",
            "kind": "label",
            "x": 0,
            "y": -5.6,
            "text": "Under Spice Lite the coil is an inductor: the contacts move a few milliseconds",
            "color": "#808080"
          },
          {
            "id": "an7",
            "kind": "label",
            "x": 0,
            "y": -3.8,
            "text": "after the switch, and with the diode the relay lets go a little late.",
            "color": "#808080"
          }
        ],
        "scopeChannels": [],
